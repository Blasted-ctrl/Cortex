{
  "name": "cortex",
  "productName": "Cortex",
  "version": "0.1.0",
  "description": "Cursor for Embedded Systems: an AI-native, multi-language IDE for low-level and embedded development.",
  "author": "kings",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run tools:build",
    "tools:build": "tsc -p tsconfig.tools.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "firmware:build": "tsc -p tsconfig.firmware.json",
    "firmware:test": "npm run firmware:build --silent && node out/firmware/main/firmwareTesting/cli.js test",
    "firmware:selftest": "npm run firmware:build --silent && node out/firmware/main/firmwareTesting/cli.js selftest",
    "firmware:bench": "npm run firmware:build --silent && node out/firmware/main/firmwareTesting/cli.js bench",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.171.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "three": "^0.171.0",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "pdf2json": "~4.0.3",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
